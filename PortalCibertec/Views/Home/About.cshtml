@{
    ViewBag.Title = "Acerca de Cibertec";
}
<h2>@ViewBag.Title</h2>

<div class="row" style="margin-top: 30px;">
    <div class="col-md-12">
        <h3>Nuestra Historia</h3>
        <p class="lead">
            Desde 1983, Cibertec ha sido líder en educación técnica superior en el Perú,
            formando profesionales altamente calificados para el mercado laboral.
        </p>
    </div>
</div>

<div class="row" style="margin-top: 20px;">
    <div class="col-md-4">
        <div class="well text-center">
            <h1 class="text-danger">40+</h1>
            <p>Años de experiencia</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="well text-center">
            <h1 class="text-danger">120,000+</h1>
            <p>Egresados exitosos</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="well text-center">
            <h1 class="text-danger">7</h1>
            <p>Sedes a nivel nacional</p>
        </div>
    </div>
</div>