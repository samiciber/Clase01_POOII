<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Mi aplicación ASP.NET</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    @Styles.Render()
    <!-- Font Awesome para iconos -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">

    <style>
        .jumbotron {
            margin-bottom: 0;
        }

        .panel:hover {
            box-shadow: 0 5px 15px rgba(0,0,0,0.3);
            transform: translateY(-5px);
            transition: all 0.3s ease;
        }

        .navbar-brand {
            font-weight: bold;
            color: #dc3545 !important;
        }

        footer {
            background-color: #333;
            color: white;
            padding: 30px 0;
            margin-top: 50px;
        }
    </style>
</head>     
<body>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="@Url.Action("Index", "Home")">
                <img src="~/Content/Images/Imagen1.png" alt="Cibertec" style="height: 30px;">
            </a>
            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Alternar navegación" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li>@Html.ActionLink("Inicio", "Index", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink("Carreras", "Index", "Carreras", new { area = "" }, new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink("Contacto", "Index", "Contacto", new { area = "" }, new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink("Cursos Cortos", "Index", "Cursos", new { area = "" }, new { @class = "nav-link" })</li>

                </ul>
            </div>
        </div>
    </nav>
    <div >
        @RenderBody()
    </div>
    <footer>
        <div class="container">
            <div class="row">
                <div class="col-md-4">
                    <h4>CIBERTEC</h4>
                    <p>Instituto de Educación Superior</p>
                </div>
                <div class="col-md-4">
                    <h4>Enlaces</h4>
                    <ul class="list-unstyled">
                        <li><a href="@Url.Action("Index", "Home")" style="color: white;">Inicio</a></li>
                        <li><a href="@Url.Action("Index", "Carreras")" style="color: white;">Carreras</a></li>
                        <li><a href="@Url.Action("Index", "Contacto")" style="color: white;">Contacto</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h4>Contacto</h4>
                    <p>
                        <i class="fa fa-phone"></i> 633-5555<br>
                        <i class="fa fa-envelope"></i> informes@cibertec.edu.pe<br>
                        <i class="fa fa-map-marker"></i> Av. Uruguay 514, Lima
                    </p>
                </div>
            </div>
            <hr style="border-color: #666;">
            <div class="text-center">
                <p>&copy; @DateTime.Now.Year CIBERTEC. Todos los derechos reservados.</p>
            </div>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
