@model PortalCibertec.Models.Carrera

@{
    ViewBag.Title = Model.Nombre + " - Cibertec";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container" style="margin-top: 20px;">
    <ol class="breadcrumb">
        <li><a href="@Url.Action("Index", "Home")">Inicio</a></li>
        <li><a href="@Url.Action("Index", "Carreras")">Carreras</a></li>
        <li class="active">@Model.Nombre</li>
    </ol>

    <div class="row">
        <div class="col-md-8">
            <div class="panel panel-default">
                <div class="panel-body">
                    <h1>@Model.Nombre</h1>
                    <hr />

                    <div class="row" style="margin-bottom: 20px;">
                        <div class="col-md-4">
                            <div class="well text-center">
                                <h4>Duración</h4>
                                <p>@Model.Duracion</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="well text-center">
                                <h4>Modalidad</h4>
                                <p>@Model.Modalidad</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="well text-center">
                                <h4>Vacantes</h4>
                                <p>@Model.VacantesDisponibles</p>
                            </div>
                        </div>
                    </div>

                    <h3>Descripción</h3>
                    <p class="lead">@Model.Descripcion</p>

                    <h3>Cursos Principales</h3>
                    <ul class="list-group">
                        @foreach (var curso in Model.Cursos)
                        {
                            <li class="list-group-item">
                                <span class="glyphicon glyphicon-ok text-success"></span> @curso
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="panel panel-danger">
                <div class="panel-heading">
                    <h3 class="panel-title text-center">Información</h3>
                </div>
                <div class="panel-body text-center">
                    <h2 class="text-danger">S/. @Model.PrecioMensual</h2>
                    <p>Pensión mensual</p>
                    <hr />
                    <a href="@Url.Action("Index", "Contacto")" class="btn btn-danger btn-lg btn-block">
                        Solicitar Información
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>