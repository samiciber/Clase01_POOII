@{
    ViewBag.Title = "Confirmación - Cibertec";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container" style="margin-top: 50px;">
    <div class="row">
        <div class="col-md-8 col-md-offset-2">
            <div class="panel panel-success">
                <div class="panel-heading">
                    <h3 class="panel-title">¡Solicitud Enviada!</h3>
                </div>
                <div class="panel-body text-center">
                    <span class="glyphicon glyphicon-ok-circle" style="font-size: 80px; color: green;"></span>
                    <h2>@ViewBag.Mensaje</h2>
                    <p class="lead">Un asesor académico se contactará contigo pronto.</p>
                    <hr />
                    <a href="@Url.Action("Index", "Home")" class="btn btn-primary">Volver al Inicio</a>
                    <a href="@Url.Action("Index", "Carreras")" class="btn btn-danger">Ver Carreras</a>
                </div>
            </div>
        </div>
    </div>
</div>